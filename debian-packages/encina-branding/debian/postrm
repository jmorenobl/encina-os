#!/bin/sh
# Tras retirar el tema hay que regenerar el initramfs y la base de dconf,
# o el sistema seguiria arrancando con un tema que ya no existe.
set -e

RUTA=/usr/share/icons/Yaru/scalable/actions/view-app-grid-ubuntu-symbolic.svg

case "$1" in
    remove|abort-install|disappear)
        # EL DESVIO DE LA BELLOTA (0.1.17): el --remove simetrico del --add
        # del preinst, que es donde esta el porque entero. dpkg ya ha
        # borrado nuestro fichero de la ruta; --rename devuelve desde
        # .distrib el enlace original de Yaru. Va aqui y no en purge porque
        # cuando llega purge el desvio ya no existe. abort-install deshace
        # el --add de un preinst que fallo; en abort-upgrade NO se toca: la
        # version vieja sigue instalada y sigue necesitando el desvio. La
        # guarda || true: un desvio que ya no este no debe abortar la
        # desinstalacion.
        dpkg-divert --package encina-branding --rename \
            --divert "$RUTA.distrib" --remove "$RUTA" || true
        ;;
esac

case "$1" in
    remove|purge)
        if command -v update-initramfs >/dev/null 2>&1; then
            update-initramfs -u || true
        fi
        if command -v dconf >/dev/null 2>&1; then
            dconf update || true
        fi
        # El drop-in de gdm.service se va con la purga (es conffile: con
        # 'remove' a secas se queda, como todo /etc); systemd tiene que
        # releer para que udev-settle deje de estar en Wants=.
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
esac

#DEBHELPER#
exit 0
