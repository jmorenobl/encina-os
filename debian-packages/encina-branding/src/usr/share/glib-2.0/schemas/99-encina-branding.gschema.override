# Predeterminados de Encina OS.
#
# Esto NO es /etc/skel (R1): alcanza a todos los usuarios, incluidos los
# creados despues de instalar el paquete, y sigue permitiendo que cada
# usuario cambie el valor por su cuenta.
#
# No hay que llamar a glib-compile-schemas (R2): libglib2.0-0 tiene un
# disparador de dpkg sobre este directorio.
#
# ---------------------------------------------------------------------------
# OJO con las secciones ':ubuntu'. No son decorativas ni redundantes.
#
# GSettings admite overrides POR ESCRITORIO: una seccion [esquema:escritorio]
# se aplica solo cuando XDG_CURRENT_DESKTOP contiene ese nombre, y tiene
# PRIORIDAD sobre la seccion generica, sea cual sea el numero del fichero.
#
# Ubuntu define [org.gnome.desktop.background:ubuntu] en su
# 10_ubuntu-settings.gschema.override, y la sesion de escritorio corre con
# XDG_CURRENT_DESKTOP=ubuntu:GNOME. Sin duplicar aqui la variante ':ubuntu',
# el fondo de Ubuntu gana siempre y el nuestro no se ve nunca, por muy alto
# que sea el 99 del nombre: no compiten en la misma categoria.
#
# El fallo es especialmente traicionero porque 'gsettings get' desde una
# terminal (sin XDG_CURRENT_DESKTOP) devuelve el valor de Encina y parece que
# todo esta bien. Para comprobarlo de verdad hay que fijar la variable:
#
#   XDG_CURRENT_DESKTOP=ubuntu:GNOME gsettings get org.gnome.desktop.background picture-uri
#
# Las secciones genericas se conservan para la sesion "GNOME" pura y para
# cualquier otro escritorio, donde Ubuntu no define variante propia.
# ---------------------------------------------------------------------------

# EL TEMA DE ICONOS. Aqui la seccion ':ubuntu' NO es una precaucion: es la
# UNICA que hace algo. Medido en la maquina instalada, sobre el fichero de
# Ubuntu que compite con este:
#
#   /usr/share/glib-2.0/schemas/10_ubuntu-settings.gschema.override
#     [org.gnome.desktop.interface:GNOME-Greeter]  icon-theme = "Yaru"
#     [org.gnome.desktop.interface:ubuntu]         icon-theme = "Yaru"
#     [org.gnome.desktop.interface:Unity]          icon-theme = "ubuntu-mono-dark"
#     [org.gnome.desktop.interface:communitheme]   icon-theme = "Suru"
#
# NO HAY SECCION GENERICA. Ubuntu solo lo fija por escritorio, y la sesion
# corre con XDG_CURRENT_DESKTOP=ubuntu:GNOME. Un [org.gnome.desktop.interface]
# a secas aqui perderia contra ':ubuntu' por muy alto que sea el 99 del
# nombre, exactamente igual que le paso al fondo en 0.1.2. La generica se
# conserva para la sesion "GNOME" pura, donde Ubuntu no define variante.
#
# Y la otra mitad, tambien medida: el usuario NO tiene el valor escrito en su
# dconf -'dconf read /org/gnome/desktop/interface/icon-theme' sale vacio, con
# el control de que la misma orden si devuelve '46.0' para
# welcome-dialog-last-shown-version-, asi que este override GANA. Si algun dia
# alguien lo cambia a mano en Ajustes, ganara la persona: es lo correcto.

# EL TEMA GTK. Desde 0.1.10 es 'Yaru-sage' y no 'Yaru', y esto NO es un tema de
# terceros: los diez acentos de Ubuntu viajan DENTRO de yaru-theme-gtk y
# yaru-theme-icon, que ya estan en la maquina. No hay paquete nuevo, ni .deb, ni
# fila en el manifiesto.
#
# POR QUE UN ACENTO Y NO UN COLOR: en Ubuntu 24.04 NO EXISTE la clave
# 'accent-color' -medido el 2026-08-14, 'gsettings list-keys' no la tiene y
# pedirla da «No existe la clave»-. Lo que el selector de Ajustes cambia es
# gtk-theme e icon-theme a 'Yaru-<acento>': el acento es un NOMBRE DE TEMA. La
# lista es cerrada y el verde encina #3A664E no esta en ella.
#
# POR QUE 'sage' Y NO 'viridian', decision de Jorge del 2026-08-14 con las tres
# capturas delante (design/capturas/acento/): viridian #03875B se lee como verde
# pero es un esmeralda llamativo; sage #657B69 es apagado, que es lo que dice
# design/identidad.md -sobria, no llamativa-.
#
# Y lo que este valor SI alcanza, medido en caliente en la maquina del producto:
# las carpetas, la seleccion de las listas y las aplicaciones GTK4/libadwaita
# -el boton «Siguiente» de la bienvenida deja de ser naranja-. Lo que NO alcanza:
# el dock y la barra superior, porque son iconos de aplicacion y el tema del
# shell no tiene variantes de acento.

[org.gnome.desktop.interface]
icon-theme='Encina'
gtk-theme='Yaru-sage'

[org.gnome.desktop.interface:ubuntu]
icon-theme='Encina'
gtk-theme='Yaru-sage'

# EL DOCK, ABAJO. Decision de Jorge del 2026-08-14.
#
# La seccion ':ubuntu' aqui NO es una precaucion, es la UNICA que hace algo:
# 10_ubuntu-dock.gschema.override define
# [org.gnome.shell.extensions.dash-to-dock:ubuntu] con dock-position='LEFT', y
# una seccion generica nuestra perderia contra ella por muy alto que sea el 99
# del nombre. Es la misma trampa que le paso al fondo en 0.1.2 y al tema de
# iconos en 0.1.9.
#
# extend-height=false deja el dock flotante y centrado en vez de ocupar el borde
# entero: asi se lee como una decision y no como el mismo dock girado.

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
extend-height=false

[org.gnome.shell.extensions.dash-to-dock:ubuntu]
dock-position='BOTTOM'
extend-height=false

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/encina/encina.jpg'
picture-uri-dark='file:///usr/share/backgrounds/encina/encina-dark.jpg'
picture-options='zoom'
primary-color='#2F4033'
secondary-color='#2F4033'

[org.gnome.desktop.background:ubuntu]
picture-uri='file:///usr/share/backgrounds/encina/encina.jpg'
picture-uri-dark='file:///usr/share/backgrounds/encina/encina-dark.jpg'
picture-options='zoom'
primary-color='#2F4033'
secondary-color='#2F4033'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/encina/encina-dark.jpg'
picture-options='zoom'
primary-color='#2F4033'

[org.gnome.desktop.screensaver:ubuntu]
picture-uri='file:///usr/share/backgrounds/encina/encina-dark.jpg'
picture-options='zoom'
primary-color='#2F4033'
