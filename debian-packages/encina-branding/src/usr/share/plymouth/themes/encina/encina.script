# Tema de arranque de Encina OS.
#
# Sigue el modelo de 'spinner', NUNCA el de 'bgrt' (R6): bgrt muestra el
# logotipo del firmware del fabricante y el logotipo propio no apareceria.

Window.SetBackgroundTopColor(0.18, 0.25, 0.20);
Window.SetBackgroundBottomColor(0.05, 0.07, 0.06);

ancho = Window.GetWidth();
alto  = Window.GetHeight();

# ------------------------------------------------------------- logotipo -----
logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = ancho / 2 - logo.image.GetWidth()  / 2;
logo.y = alto  / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 0);

# Latido del logotipo, para que se vea que el sistema sigue vivo.
#
# El calculo es el del tema de referencia de Plymouth
# (/usr/share/plymouth/themes/script/script.script): el angulo avanza a 0,5 Hz
# suponiendo un refresco de 50 fps.
#
# OJO con el RANGO. Un latido de 0,80 a 1,00 es imperceptible sobre un
# logotipo verde oscuro contra un fondo verde oscuro: parece una imagen
# estatica. Hace falta un recorrido amplio, como el 0,30-1,00 del tema de
# referencia. Si algun dia se cambia el logotipo por uno de mas contraste,
# este rango se puede estrechar.
logo.angulo = 0;
fun refresh_callback() {
    logo.angulo = logo.angulo + ((2 * 3.14) / 50) * 0.5;
    opacidad = (Math.Cos(logo.angulo) + 1) / 2;   # 0,00 .. 1,00
    logo.sprite.SetOpacity(0.35 + opacidad * 0.65);
}
Plymouth.SetRefreshFunction(refresh_callback);

# ------------------------------------------------------ barra de progreso ---
# Un latido solo dice "sigo vivo". La barra dice ademas "voy por aqui", que es
# lo que espera cualquiera mirando un arranque.
#
# Se hace escalando una imagen solida, que es como lo resuelve el tema de
# referencia: Image.Scale() devuelve una imagen nueva y se le asigna al sprite.
barra.fondo_imagen = Image("barra-fondo.png");
barra.fondo_sprite = Sprite(barra.fondo_imagen);
barra.x = ancho / 2 - barra.fondo_imagen.GetWidth() / 2;
barra.y = logo.y + logo.image.GetHeight() + 60;
barra.fondo_sprite.SetPosition(barra.x, barra.y, 1);

barra.imagen  = Image("barra.png");
barra.sprite  = Sprite();
barra.sprite.SetPosition(barra.x, barra.y, 2);
barra.ancho_previo = -1;

fun progress_callback(duracion, progreso) {
    nuevo = Math.Int(barra.imagen.GetWidth() * progreso);
    if (nuevo < 1) nuevo = 1;
    # Solo se reescala cuando cambia el ancho en pixeles enteros: reescalar en
    # cada refresco desperdicia trabajo durante todo el arranque.
    if (nuevo != barra.ancho_previo) {
        barra.ancho_previo = nuevo;
        barra.sprite.SetImage(barra.imagen.Scale(nuevo, barra.imagen.GetHeight()));
    }
}
Plymouth.SetBootProgressFunction(progress_callback);

# -------------------------------------------------------------- mensajes ----
mensaje.sprite = Sprite();
fun display_message_callback(texto) {
    mensaje.image = Image.Text(texto, 0.9, 0.9, 0.9);
    mensaje.sprite.SetImage(mensaje.image);
    mensaje.sprite.SetPosition(ancho / 2 - mensaje.image.GetWidth() / 2,
                               logo.y + logo.image.GetHeight() + 40, 1);
}
fun hide_message_callback(texto) {
    mensaje.sprite.SetImage(NULL);
}
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

# ------------------------------------------------ contrasena de disco LUKS ---
# SIN ESTO, en un equipo con disco cifrado el arranque se queda en negro y
# no pide la frase de paso. Solo se manifiesta en maquinas cifradas: no se
# reproduce en una VM sin LUKS.
aviso.sprite = Sprite();
puntos.sprite = Sprite();

fun display_password_callback(prompt, bullets) {
    logo.sprite.SetOpacity(1);

    aviso.image = Image.Text(prompt, 0.9, 0.9, 0.9);
    aviso.sprite.SetImage(aviso.image);
    aviso.sprite.SetPosition(ancho / 2 - aviso.image.GetWidth() / 2,
                             logo.y + logo.image.GetHeight() + 40, 1);

    cadena = "";
    for (i = 0; i < bullets; i++) {
        cadena += "*";
    }
    puntos.image = Image.Text(cadena, 0.9, 0.9, 0.9);
    puntos.sprite.SetImage(puntos.image);
    puntos.sprite.SetPosition(ancho / 2 - puntos.image.GetWidth() / 2,
                              logo.y + logo.image.GetHeight() + 80, 1);
}

fun display_normal_callback() {
    aviso.sprite.SetImage(NULL);
    puntos.sprite.SetImage(NULL);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ----------------------------------------------------------------- salida ---
fun quit_callback() {
    logo.sprite.SetOpacity(1);
}
Plymouth.SetQuitFunction(quit_callback);
